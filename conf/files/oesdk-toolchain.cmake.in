#
# Cmake toolchain file for yocto/openembedded cross builds.
# This is an alternative to using the regular OE environment setup such as `environment-setup-armv8a-oe-linux`
#
# usage: 
#   cmake --toolchain path/to/this-file {other options}
#
# or via CMakePresets.json

##  template variables (sandwiched by @@)
##
## oecore_target_arch - cpu architecture for the target (e.g. aarch64)
## target_prefix - prefx of the target tools (e.g. aarch64-oe-linux-)
## sdk_target_sysroot - sysroot for the target (/usr/local/oe-sdk-hardcoded-buildpath/sysroots/armv8a-oe-linux)
## oecore_native_sysroot - sysroot for native sdk (/usr/local/oe-sdk-hardcoded-buildpath/sysroots/aarch64-oesdk-darwin21)
## sdk_exec_path - OS PATH prepended to standard path to find executables 

set(CMAKE_SYSTEM_NAME Linux) #  this is always linux, could be OECORE_TARGET_OS (which is still linux) I guess
set(CMAKE_SYSTEM_PROCESSOR @oecore_target_arch@)

set(CMAKE_SYSROOT @sdk_target_sysroot@)
set(OECORE_NATIVE_SYSROOT @oecore_native_sysroot@)

set(exe_path $ENV{PATH})
set(ENV{PATH} @sdk_exec_path@:$ENV{PATH})

#
# Attempt to keep a single toolchain file that works
# for both clang and gcc.  It would be nice if we could
# pass in a CMAKE option var like "OESDK_TOOLCHAIN", but
# that didn't seem to work with sub-builds (as in add_subdirectory(...))
#
# So we go with a fallback where we can rename or symlink this
# file to oesdk-toolchain-clang.cmake and include it that way if we
# want clang.  Otherwise default to gcc (as the most mature)

message("toolchain is : ${CMAKE_CURRENT_LIST_FILE}")
string(FIND "${CMAKE_CURRENT_LIST_FILE}" "clang" clang_index)
if(${clang_index} GREATER -1)
set(OESDK_TOOLCHAIN "clang")
else()
set(OESDK_TOOLCHAIN "gcc")
endif()

#
# and keep this chicanery/logic in place in case
# we figure out how to pass in a specific value some day

if(OESDK_TOOLCHAIN STREQUAL "clang")
  set(CMAKE_CXX_COMPILER @target_prefix@clang++)
  set(CMAKE_C_COMPILER @target_prefix@clang)
  set(CMAKE_LINKER @target_prefix@lld)
  set(CMAKE_AR @target_prefix@llvm-ar)
  set(CMAKE_RANLIB @target_prefix@llvm-ranlib)
elseif(OESDK_TOOLCHAIN STREQUAL "gcc")
  set(CMAKE_CXX_COMPILER @target_prefix@g++)
  set(CMAKE_C_COMPILER @target_prefix@gcc)
  set(CMAKE_LINKER @target_prefix@ld)
  set(CMAKE_AR @target_prefix@ar)
  set(CMAKE_RANLIB @target_prefix@ranlib)
else()
  message(FATAL_ERROR "Unknown OESDK_TOOLCHAIN")
endif()

# cmake built-in settings to use find_xxx() functions
set(CMAKE_FIND_ROOT_PATH ${CMAKE_SYSROOT})

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

set(CMAKE_C_STANDARD_COMPUTED_DEFAULT 17)
set(CMAKE_CXX_STANDARD_COMPUTED_DEFAULT 17)

set(ENV{PKG_CONFIG_PATH} ${CMAKE_SYSROOT}/usr/lib/pkgconfig:${CMAKE_SYSROOT}/usr/share/pkgconfig)
set(ENV{PKG_CONFIG_SYSROOT_DIR} ${CMAKE_SYSROOT})

message("pkg-config-path: $ENV{PKG_CONFIG_PATH}")
message("pkg-config-sysroot-dir: $ENV{PKG_CONFIG_SYSROOT_DIR}")
