#
# Cmake toolchain file for yocto/openembedded cross builds.
# This is an alternative to using the regular OE environment setup such as `environment-setup-armv8a-oe-linux`
#
# usage: 
#   cmake --toolchain path/to/this-file {other options}
#
# or via CMakePresets.json

##  template variables (sandwiched by @@)
##
##  sdk_install_path : The installed path of the SDK with sysroots
##                   (e.g. "/Volumes/oe-sdk-xx")
##
##  toolchain_tuple : The tuple for the toolchain
##                    (e.g "aarch64-oe-linux")
##
##  target_tuple : The tupole for the target machine/system
##                 (e.g. "armv8a-oe-linux")
##
##  oesdk_tuple : The tuple for the nativesdk build
##                (e.g. "aarch64-oesdk-darwin21")
##
##  target_architecture : The target machine architecture
##                        (e.g. "aarch64")

set(CMAKE_SYSTEM_NAME Linux) #  this is always linux
set(CMAKE_SYSTEM_PROCESSOR @target_architecture@)

set(OE_SDK @sdk_install_path@)
set(TC_TUPLE @toolchain_tuple@) ## aarch64-oe-linux
set(OE_TARGET @target_tuple@)   ## armv8a-oe-linux
set(OE_SDK_TUPLE @oesdk_tuple@) ## aarch64-oesdk-darwin21

set(TOOLCHAIN_PATH ${OE_SDK}/sysroots/${OE_SDK_TUPLE}/usr/bin/${TC_TUPLE}/${TC_TUPLE}-)

set(X_SYSROOT ${OE_SDK}/sysroots/${OE_TARGET})
set(CMAKE_SYSROOT ${X_SYSROOT})

message("toolchain is : ${OESDK_TOOLCHAIN}")
if(OESDK_TOOLCHAIN STREQUAL "clang")
  set(CMAKE_CXX_COMPILER ${TOOLCHAIN_PATH}clang++)
  set(CMAKE_C_COMPILER ${TOOLCHAIN_PATH}clang)
  set(CMAKE_LINKER ${TOOLCHAIN_PATH}lld)
  set(CMAKE_AR ${TOOLCHAIN_PATH}llvm-ar)
  set(CMAKE_RANLIB ${TOOLCHAIN_PATH}llvm-ranlib)
elseif(OESDK_TOOLCHAIN STREQUAL "gcc")
  set(CMAKE_CXX_COMPILER ${TOOLCHAIN_PATH}g++)
  set(CMAKE_C_COMPILER ${TOOLCHAIN_PATH}gcc)
  set(CMAKE_LINKER ${TOOLCHAIN_PATH}ld)
  set(CMAKE_AR ${TOOLCHAIN_PATH}ar)
  set(CMAKE_RANLIB ${TOOLCHAIN_PATH}ranlib)
else()
  message(FATAL_ERROR "Unknown OESDK_TOOLCHAIN")
endif()

# cmake built-in settings to use find_xxx() functions
set(CMAKE_FIND_ROOT_PATH ${X_SYSROOT})

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

set(CMAKE_C_STANDARD_COMPUTED_DEFAULT 17)
set(CMAKE_CXX_STANDARD_COMPUTED_DEFAULT 17)

set(CMAKE_C_STANDARD 17)

set(ENV{PKG_CONFIG_PATH} ${X_SYSROOT}/usr/lib/pkgconfig)
set(ENV{PKG_CONFIG_SYSROOT_DIR} ${X_SYSROOT})

message("pkg-config-path: $ENV{PKG_CONFIG_PATH}")
message("pkg-config-sysroot-dir: $ENV{PKG_CONFIG_SYSROOT_DIR}")
