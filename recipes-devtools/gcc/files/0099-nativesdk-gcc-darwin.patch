From 06f75c32bc364d607f103622deb59e1a4ebd9caf Mon Sep 17 00:00:00 2001
From: Etienne Cordonnier <ecordonnier@snap.com>
Date: Wed, 3 Aug 2022 13:37:20 +0200
Subject: [PATCH] rebase patch "0099-nativesdk-gcc-darwin.patch" from
 meta-darwin

Upstream-Status: Inappropriate [OE specific]
Signed-off-by: Etienne Cordonnier <ecordonnier@snap.com>
---
 gcc/config/darwin-c.c | 4 ++--
 gcc/config/darwin.h   | 5 +----
 2 files changed, 3 insertions(+), 6 deletions(-)

diff --git a/gcc/config/darwin-c.c b/gcc/config/darwin-c.c
index 8b3dec25476..a3c71f109a8 100644
--- a/gcc/config/darwin-c.c
+++ b/gcc/config/darwin-c.c
@@ -479,8 +479,8 @@ darwin_register_objc_includes (const char *sysroot ATTRIBUTE_UNUSED,
      /* See if our directory starts with the standard prefix.
 	 "Translate" them, i.e. replace /usr/local/lib/gcc... with
 	 IPREFIX and search them first.  */
-      if (iprefix && (len = cpp_GCC_INCLUDE_DIR_len) != 0
-	  && !strncmp (fname, cpp_GCC_INCLUDE_DIR, len))
+      if (iprefix && (len = strlen(GCC_INCLUDE_DIRVAR) - 7) != 0
+	  && !strncmp (fname, GCC_INCLUDE_DIRVAR, len))
 	{
 	  str = concat (iprefix, fname + len, NULL);
 	  add_path (str, INC_SYSTEM, /*c++aware=*/true, false);
diff --git a/gcc/config/darwin.h b/gcc/config/darwin.h
index 3206b70c7c2..59c25c88035 100644
--- a/gcc/config/darwin.h
+++ b/gcc/config/darwin.h
@@ -384,6 +384,7 @@ extern GTY(()) int darwin_ms_struct;
 	%:version-compare(>= 10.11 asm_macosx_version_min= ___emutls_register_common) \
       }} \
     }}}\
+    %{!nostdlib++:}\
     %{!r:%{!nostdlib:%{!nostartfiles:%E}}} %{T*} %{F*} "\
     DARWIN_PIE_SPEC \
     DARWIN_NOPIE_SPEC \
@@ -427,10 +428,6 @@ extern GTY(()) int darwin_ms_struct;
    isysroot is specified.  */
 #define LINK_SYSROOT_SPEC "%{isysroot*:-syslibroot %*} "
 
-/* Suppress the addition of extra prefix paths when a sysroot is in use.  */
-#define STANDARD_STARTFILE_PREFIX_1 ""
-#define STANDARD_STARTFILE_PREFIX_2 ""
-
 
 /* Please keep the random linker options in alphabetical order.
    Note that options taking arguments may appear multiple times on a command
-- 
